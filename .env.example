# Copia a .env.local (local) o configúralas en Netlify. Nunca subas valores reales.

# --- Base de datos ---
# Producción: Supabase → Connect → "Transaction pooler" (puerto 6543).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migraciones (drizzle-kit): "Session pooler" o conexión directa (puerto 5432).
# DATABASE_URL_DIRECT=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Sin DATABASE_URL se usa PGlite (Postgres embebido). Carpeta para persistirlo:
PGLITE_DIR=./.pglite

# --- Supabase Auth (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clave anon / publishable (sb_publishable_…). También vale el nombre NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: invitaciones y seed del admin. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (enlaces de invitación y recuperación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para `npm run seed:admin`.
ADMIN_EMAIL=
